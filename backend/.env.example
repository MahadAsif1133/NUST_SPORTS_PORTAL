# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://nust_admin:nust_dev_password_2024@localhost:5432/nust_sports

# JWT
JWT_SECRET=nust-sports-dev-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=nust-sports-dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256-GCM key — 32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# QR Token
QR_TOKEN_EXPIRY_SECONDS=60

# OTP
OTP_EXPIRY_MINUTES=5

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
FRONTEND_URL=http://localhost:5173

# Provider Selection
STUDENT_DATA_PROVIDER=mock
PAYMENT_PROVIDER=mock
STORAGE_PROVIDER=local

# CSRF
CSRF_SECRET=nust-sports-dev-csrf-secret-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3
